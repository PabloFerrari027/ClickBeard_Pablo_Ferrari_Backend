NODE_ENV=test
PORT=3001

# Dedicated database — same Postgres container as `.env` (started via
# `npm run db:up`), but a different logical database, so `npm run
# test:e2e` never touches the dev DB (`app`) from `.env`. Created
# automatically by `npm run db:test:create` (also runs as part of
# `pretest:e2e`, which fires before every `npm run test:e2e`).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=clickbeard_test
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000
DB_SSL=false

# Same Redis server as `.env` (started via `npm run db:up`), but a
# different logical DB index (`SELECT 1`) — keeps the e2e suite's BullMQ
# queues and cache keys from colliding with a `npm run dev` instance
# running against DB 0 at the same time.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

JWT_ACCESS_SECRET=test-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=4

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ClickBeard <test@clickbeard.local>
SMTP_SECURE=false

CORS_ORIGIN=*
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000

# Read directly by test/global-setup.ts to re-seed the bootstrap admin
# before every e2e run (see getAdminSession in test/support/api.helpers.ts).
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@clickbeard.local
SEED_ADMIN_PASSWORD=test-admin-password
