NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000
DB_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ClickBeard <no-reply@clickbeard.local>
SMTP_SECURE=false

CORS_ORIGIN=*
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Used only by `npm run seed:up` (database/seeders) to bootstrap the
# first ADMIN account — not read by the running app.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@clickbeard.local
SEED_ADMIN_PASSWORD=change-me
